{
  "name": "football-manager-sim",
  "main": "expo-router/entry",
  "version": "4.0.1",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "analyze": "tsx -r ./scripts/mock-env.js scripts/detailed_season_sim.ts",
    "track:season": "tsx -r ./scripts/mock-env.js scripts/season_tracker.ts",
    "qa": "tsx -r ./scripts/mock-env.js scripts/autonomous_qa.ts",
    "turbo": "tsx -r ./scripts/mock-env.js scripts/turbo_sim.ts",
    "test:regression": "tsx -r ./scripts/mock-env.js scripts/regression_checks.ts",
    "check:save": "tsx -r ./scripts/mock-env.js scripts/save_integrity_check.ts",
    "check:agent": "tsx -r ./scripts/mock-env.js scripts/agent_game_check.ts",
    "check:season": "tsx -r ./scripts/mock-env.js scripts/agent_season_playthrough.ts",
    "test:ci": "tsx -r ./scripts/mock-env.js scripts/ci_regression.ts",
    "test:news": "tsx -r ./scripts/mock-env.js scripts/test_news_output.ts",
    "ci": "npm run -s typecheck && npm run -s lint && npm run -s test:ci && npm run -s test:regression && npm run -s check:save && npm run -s check:agent",
    "gate:release": "npm run -s ci && npm run -s check:season"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^3.0.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@types/uuid": "^10.0.0",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "uuid": "^13.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "private": true
}

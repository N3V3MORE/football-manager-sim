{
  "name": "football-manager-sim",
  "main": "expo-router/entry",
  "version": "4.3.0",
  "scripts": {
    "postinstall": "node ./scripts/patch-runtime-dependencies.cjs",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint --max-warnings=0",
    "test": "node ./scripts/test.cjs",
    "test:slow": "node ./scripts/test.cjs --slow",
    "simulate": "tsx -r ./scripts/mock-env.js scripts/simulate.ts",
    "bench": "tsx -r ./scripts/mock-env.js scripts/benchmark.ts",
    "check:deadcode": "ts-prune -e",
    "doctor:release": "node scripts/expo_doctor_gate.js",
    "ci": "npm run -s typecheck && npm run -s lint && npm run -s test",
    "gate:release": "npm run -s ci && npm run -s test:slow && npm run -s check:deadcode && npm run -s doctor:release && npx expo export"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "uuid": "13.0.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "expo-doctor": "1.20.4",
    "ts-prune": "0.10.3",
    "tsx": "4.22.4",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@react-native/dev-middleware": {
      "ws": "6.2.4"
    },
    "@xmldom/xmldom": "0.8.15",
    "@humanfs/node": "0.16.8",
    "baseline-browser-mapping": "2.11.0",
    "browserslist": "4.28.7",
    "brace-expansion@^1": "1.1.18",
    "brace-expansion@^2": "2.1.4",
    "brace-expansion@^5": "5.0.9",
    "decode-uri-component": "0.5.0",
    "image-size": "2.0.4",
    "js-yaml": "4.3.2",
    "nanoid@^3": "3.3.18",
    "tar": "7.5.21",
    "undici@^6": "6.28.1",
    "metro": {
      "ws": "7.5.11"
    },
    "postcss": "8.5.23",
    "react-devtools-core": {
      "shell-quote": "1.9.0",
      "ws": "7.5.11"
    },
    "react-native": {
      "ws": "6.2.4"
    },
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "private": true
}
